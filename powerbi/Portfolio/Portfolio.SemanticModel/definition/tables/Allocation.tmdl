table Allocation
	lineageTag: 124363cd-5010-49db-84c1-b0652d606b3a

	measure 'Records' = SUM(Allocation[Patients])
		formatString: #,0

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column Patients
		dataType: int64
		summarizeBy: none
		sourceColumn: Patients

	partition Allocation = m
		mode: import
		source =
				#table(type table [Category = text, Patients = number], {
					{"Priority review", 8},
					{"Routine support", 33},
					{"No rule flag", 9}
				})
